# syntax=docker/dockerfile:1
FROM oven/bun:1.4.4-slim AS builder
WORKDIR /app
COPY . .
ARG PAT_GITHUB
ARG FASTSTATS_UPLOAD_TOKEN
ARG VITE_FASTSTATS_SITEKEY
ARG VITE_FASTSTATS_SCRIPT_URL
ARG VITE_PUBLIC_BASE_URL
ARG VITE_PUBLIC_POSTHOG_PROJECT_TOKEN
ARG VITE_PUBLIC_POSTHOG_HOST
ARG POSTHOG_PROJECT_ID
ARG POSTHOG_HOST
ARG POSTHOG_RELEASE_NAME=thenextlvl-docs
ARG POSTHOG_RELEASE_VERSION=0.0.0
ARG GITHUB_REF_NAME
ARG GITHUB_SHA

ENV VITE_FASTSTATS_SITEKEY=$VITE_FASTSTATS_SITEKEY
ENV VITE_FASTSTATS_SCRIPT_URL=$VITE_FASTSTATS_SCRIPT_URL
ENV VITE_PUBLIC_BASE_URL=$VITE_PUBLIC_BASE_URL
ENV VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=$VITE_PUBLIC_POSTHOG_PROJECT_TOKEN
ENV VITE_PUBLIC_POSTHOG_HOST=$VITE_PUBLIC_POSTHOG_HOST
ENV POSTHOG_PROJECT_ID=$POSTHOG_PROJECT_ID
ENV POSTHOG_HOST=$POSTHOG_HOST
ENV POSTHOG_RELEASE_NAME=$POSTHOG_RELEASE_NAME
ENV POSTHOG_RELEASE_VERSION=$POSTHOG_RELEASE_VERSION

RUN bun install --frozen-lockfile
RUN --mount=type=secret,id=POSTHOG_API_KEY,env=POSTHOG_API_KEY bun run build

FROM oven/bun:1.4.4-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/.output /app/.output
EXPOSE 3000
CMD ["bun", "run", ".output/server/index.mjs"]
